# Copy to .env. docker compose reads it for LocalStack; pnpm test:integration reads the AWS_* entries.

# Required by docker/docker-compose.yml: https://docs.localstack.cloud/getting-started/auth-token/
LOCALSTACK_AUTH_TOKEN=

# Standard AWS SDK settings the integration suite runs with. No code branches on them.
# The *.localhost.localstack.cloud host resolves to 127.0.0.1 for every bucket subdomain, so the SDK's
# default virtual-hosted addressing works and no path-style setting is needed. The JavaScript SDK has
# no environment variable for forcePathStyle.
AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
